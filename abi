#!/usr/bin/env bash

########################
# Author: Shinichi Okada
# Date: 2021-05-26
# Updated: 2025-01-17
# abi (Automate Brew Install)
###########################

set -euo pipefail

# Script metadata
readonly VERSION="0.2.0"
readonly SCRIPT_NAME=$(basename "$0")

# Default values
type=""
install_type=""
list_description="My brew list"
cask_description="My brew cask list"
list_filename="my-brew-formula"
cask_filename="my-brew-cask-formula"
visibility="secret"
url=""
dry_run=false
verbose=false
log_file=""

# Color codes
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# URL validation regex
readonly URL_REGEX='(https?|ftp|file)://[-A-Za-z0-9\+&@#/%?=~_|!:,.;]*[-A-Za-z0-9\+&@#/%=~_|]'

# Statistics
declare -i total_packages=0
declare -i installed_packages=0
declare -i failed_packages=0
declare -a failed_package_list=()

# Cleanup on exit
trap cleanup EXIT

cleanup() {
    if [[ -n "${tmpfile:-}" ]] && [[ -f "${tmpfile}" ]]; then
        rm -f "${tmpfile}"
    fi
}

# Logging functions
log() {
    local message="$1"
    echo -e "${message}"
    if [[ -n "${log_file}" ]]; then
        echo -e "${message}" | sed 's/\x1b\[[0-9;]*m//g' >> "${log_file}"
    fi
}

log_info() {
    log "${BLUE}[INFO]${NC} $*"
}

log_success() {
    log "${GREEN}[SUCCESS]${NC} $*"
}

log_warning() {
    log "${YELLOW}[WARNING]${NC} $*"
}

log_error() {
    log "${RED}[ERROR]${NC} $*" >&2
}

abort() {
    log_error "$*"
    exit 1
}

required() { 
    [[ $# -gt 1 ]] || abort "option '$1' requires an argument"
}

usage() {
    cat <<EOF
${BLUE}Name:${NC} ${SCRIPT_NAME}

${BLUE}Description:${NC} This script creates a Gist from your Homebrew formula or cask. 
It can install Homebrew formula or cask from the Gist.

${BLUE}Requirements:${NC}
  - brew (Homebrew)
  - gh (GitHub CLI)

${BLUE}Usage:${NC}
  ${SCRIPT_NAME} leaves [-d <description>] [-f <filename>] [-p]
  ${SCRIPT_NAME} cask [-d <description>] [-f <filename>] [-p]
  ${SCRIPT_NAME} install <Gist-url> [--dry-run] [--log <file>]
  ${SCRIPT_NAME} installcask <Gist-url> [--dry-run] [--log <file>]

${BLUE}Options:${NC}
  -d, --desc <text>       Gist description [default: "My brew list" | "My brew cask list"]
  -f, --filename <name>   Gist file name [default: "my-brew-formula" | "my-brew-cask-formula"]
  -p, --public            Make Gist public [default: secret]
      --dry-run           Preview installation without actually installing
      --log <file>        Write log to specified file
  -V, --verbose           Enable verbose output
  -h, --help              Show this help message
  -v, --version           Show script version

${BLUE}Examples:${NC}

  ${GREEN}# Create a Homebrew formula Gist${NC}
  ${SCRIPT_NAME} leaves

  ${GREEN}# Create a Homebrew cask formula Gist${NC}
  ${SCRIPT_NAME} cask

  ${GREEN}# Create a Gist with custom description and filename${NC}
  ${SCRIPT_NAME} leaves -d "my new brew list" -f hello-brew
  ${SCRIPT_NAME} cask -d "my new brew cask list" -f hello-cask-brew

  ${GREEN}# Create a public Gist${NC}
  ${SCRIPT_NAME} leaves -p
  ${SCRIPT_NAME} cask -p

  ${GREEN}# Install from a Gist (preview first)${NC}
  ${SCRIPT_NAME} install --dry-run <Gist-URL>

  ${GREEN}# Install from a Gist with logging${NC}
  ${SCRIPT_NAME} install --log install.log <Gist-URL>

  ${GREEN}# Install Homebrew cask formula from a Gist${NC}
  ${SCRIPT_NAME} installcask <Gist-CASK-URL>

EOF
    exit 0
}

# Parse command line arguments
while (($# > 0)); do
    case $1 in
    -d | --desc | --description)
        required "$@"
        list_description="${2}"
        cask_description="${2}"
        shift 2
        ;;
    -f | --filename)
        required "$@"
        list_filename="${2}"
        cask_filename="${2}"
        shift 2
        ;;
    -p | --public)
        visibility="public"
        shift
        ;;
    --dry-run)
        dry_run=true
        shift
        ;;
    --log)
        required "$@"
        log_file="${2}"
        shift 2
        ;;
    -V | --verbose)
        verbose=true
        shift
        ;;
    leaves)
        type="leaves"
        shift
        ;;
    cask)
        type="cask"
        shift
        ;;
    install)
        install_type="list"
        shift
        if [[ $# -eq 0 ]] || [[ "$1" == --* ]]; then
            abort "install command requires a Gist URL"
        fi
        url="$1"
        shift
        ;;
    installcask)
        install_type="--cask"
        shift
        if [[ $# -eq 0 ]] || [[ "$1" == --* ]]; then
            abort "installcask command requires a Gist URL"
        fi
        url="$1"
        shift
        ;;
    -v | --version)
        echo "${VERSION}"
        exit 0
        ;;
    -h | --help)
        usage
        ;;
    *)
        log_error "Unknown option: $1"
        echo ""
        usage
        ;;
    esac
done

check_os() {
    if ! [[ "$OSTYPE" =~ darwin* ]] && ! [[ "$OSTYPE" =~ linux* ]]; then
        abort "This script is meant to be run on macOS or Linux only"
    fi
    log_info "Operating system check passed"
}

check_cmd() {
    local cmd="$1"
    if ! command -v "${cmd}" &>/dev/null; then
        abort "Command '${cmd}' not found. Please install ${cmd} or add it to your PATH"
    fi
    log_info "${cmd} is available"
}

check_gh_auth() {
    # Use timeout to prevent hanging in non-interactive environments
    if ! timeout 5s gh auth status &>/dev/null; then
        abort "GitHub CLI (gh) is not authenticated. Please run 'gh auth login' first"
    fi
    log_info "GitHub CLI authentication verified"
}

validate_url() {
    local url_to_check="$1"
    if ! [[ ${url_to_check} =~ ${URL_REGEX} ]]; then
        abort "Invalid URL format: ${url_to_check}"
    fi
    
    # Check if it's a GitHub Gist URL
    if ! [[ ${url_to_check} =~ gist\.github\.com ]]; then
        log_warning "URL does not appear to be a GitHub Gist"
    fi
}

fetch_gist_content() {
    local gist_url="$1"
    local output_file="$2"
    
    validate_url "${gist_url}"
    
    local raw_url="${gist_url}/raw"
    log_info "Fetching Gist content from: ${raw_url}"
    
    if ! curl --silent --head --fail --max-time 10 "${raw_url}" &>/dev/null; then
        abort "Failed to access Gist URL: ${raw_url}"
    fi
    
    if ! curl -L --silent --fail --max-time 30 "${raw_url}" > "${output_file}"; then
        abort "Failed to download Gist content"
    fi
    
    if [[ ! -s "${output_file}" ]]; then
        abort "Downloaded Gist content is empty"
    fi
    
    log_success "Successfully fetched Gist content"
}

fn_createList() {
    local list_type="$1"
    local list_name
    local filename
    local description
    local visi_opt=""

    log_info "Creating Gist from Homebrew ${list_type}..."
    
    if [[ ${list_type} == "cask" ]]; then
        list_name="list --cask"
        filename="${cask_filename}"
        description="${cask_description}"
    elif [[ ${list_type} == "leaves" ]]; then
        list_name="leaves"
        filename="${list_filename}"
        description="${list_description}"
    else
        abort "Invalid list type: ${list_type}"
    fi

    if [[ "${visibility}" == "public" ]]; then
        visi_opt="-p"
    fi

    echo ""
    log_info "Gist Configuration:"
    echo "  Description: ${description}"
    echo "  Filename: ${filename}"
    echo "  List command: brew ${list_name}"
    echo "  Visibility: ${visibility}"
    echo ""
    
    read -rp "Do you want to create this Gist? (yes/no): " response
    
    case "${response}" in
        [Yy]|[Yy][Ee][Ss])
            log_info "Creating Gist..."
            
            # shellcheck disable=SC2086
            if brew ${list_name} | gh gist create -w -f "${filename}" -d "${description}" ${visi_opt}; then
                log_success "Gist created successfully!"
                log_info "Please save the URL that was opened in your browser"
            else
                abort "Failed to create Gist"
            fi
            ;;
        *)
            log_info "Gist creation cancelled"
            exit 0
            ;;
    esac
}

install_package() {
    local pkg_install_type="$1"
    local formula="$2"
    
    if ${dry_run}; then
        log_info "[DRY RUN] Would install: brew install ${pkg_install_type} ${formula}"
        return 0
    fi
    
    log_info "Installing ${formula}..."
    
    # shellcheck disable=SC2086
    if brew install ${pkg_install_type} "${formula}"; then
        log_success "Installed ${formula}"
        ((installed_packages++))
        return 0
    else
        log_error "Failed to install ${formula}"
        ((failed_packages++))
        failed_package_list+=("${formula}")
        return 1
    fi
}

tap_formula() {
    local tap_name="$1"
    
    if ${dry_run}; then
        log_info "[DRY RUN] Would tap: ${tap_name}"
        return 0
    fi
    
    log_info "Tapping ${tap_name}..."
    
    if brew tap "${tap_name}"; then
        log_success "Tapped ${tap_name}"
        return 0
    else
        log_error "Failed to tap ${tap_name}"
        return 1
    fi
}

fn_install() {
    local pkg_install_type="$1"
    local gist_url="$2"
    
    if [[ -z "${gist_url}" ]]; then
        abort "Please provide a Gist URL"
    fi
    
    tmpfile=$(mktemp /tmp/abi-list.XXXXXX)
    
    fetch_gist_content "${gist_url}" "${tmpfile}"
    
    # Read packages into array
    mapfile -t packages < "${tmpfile}"
    total_packages=${#packages[@]}
    
    if [[ ${total_packages} -eq 0 ]]; then
        abort "No packages found in Gist"
    fi
    
    log_info "Found ${total_packages} package(s) to process"
    
    if ${dry_run}; then
        log_warning "DRY RUN MODE - No packages will be installed"
        echo ""
    fi
    
    # Display package list
    log_info "Package list:"
    for pkg in "${packages[@]}"; do
        echo "  - ${pkg}"
    done
    echo ""
    
    if ! ${dry_run}; then
        read -rp "Do you want to proceed with installation? (yes/no): " response
        case "${response}" in
            [Yy]|[Yy][Ee][Ss])
                log_info "Starting installation..."
                ;;
            *)
                log_info "Installation cancelled"
                exit 0
                ;;
        esac
    fi
    
    # Process each package
    for element in "${packages[@]}"; do
        # Skip empty lines and comments
        [[ -z "${element}" ]] || [[ "${element}" =~ ^# ]] && continue
        
        if [[ "${element}" == *"/"* ]]; then
            # Handle tap formulas (e.g., shinokada/abi/abi)
            tap_name="${element%/*}"
            formula="${element##*/}"
            
            tap_formula "${tap_name}"
            
            # Preserve install type for cask formulas from taps
            local tap_install_opt="${pkg_install_type}"
            if [[ "${tap_install_opt}" == "list" ]]; then
                tap_install_opt=""
            fi
            install_package "${tap_install_opt}" "${formula}"
        else
            # Regular formula
            formula="${element}"
            local install_opt="${pkg_install_type}"
            
            # Regular formulas don't need install_type
            if [[ "${install_opt}" == "list" ]]; then
                install_opt=""
            fi
            
            install_package "${install_opt}" "${formula}"
        fi
    done
    
    # Print summary
    echo ""
    log_info "===== Installation Summary ====="
    echo "  Total packages: ${total_packages}"
    echo "  Successfully installed: ${installed_packages}"
    echo "  Failed: ${failed_packages}"
    
    if [[ ${failed_packages} -gt 0 ]]; then
        echo ""
        log_error "Failed packages:"
        for failed_pkg in "${failed_package_list[@]}"; do
            echo "  - ${failed_pkg}"
        done
    fi
    echo ""
    
    if ${dry_run}; then
        log_info "This was a dry run. No packages were actually installed."
    fi
}

main() {
    # Check requirements
    log_info "Checking system requirements..."
    check_os
    check_cmd brew
    check_cmd gh
    
    # Check GitHub CLI authentication for operations that need it
    if [[ -n "${type}" ]] || [[ -n "${install_type}" ]]; then
        check_gh_auth
    fi
    
    # Execute requested operation
    if [[ -n "${type}" ]]; then
        fn_createList "${type}"
    elif [[ -n "${install_type}" ]]; then
        fn_install "${install_type}" "${url}"
    else
        log_error "No command specified"
        echo ""
        usage
    fi
    
    log_success "Task completed successfully!"
}

# Run main function
main "$@"
